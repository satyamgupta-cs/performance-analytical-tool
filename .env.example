# Copy this file to .env (in the same folder as app.py) and fill in your own
# values. Environment variables always override whatever is saved from the
# Settings page in database/db_config.json.
#
# ---- Finding these values in pgAdmin ----
# In pgAdmin's left tree: right-click your server -> Properties.
#   DB_HOST     -> "Connection" tab -> Host name/address (often "localhost")
#   DB_PORT     -> "Connection" tab -> Port (usually 5432)
#   DB_USER     -> "Connection" tab -> Username (often "postgres")
#   DB_PASSWORD -> the password you set when the server was registered
#                  (pgAdmin itself doesn't show it back to you)
#   DB_NAME     -> the specific database under that server you want to use,
#                  e.g. "staffscore" (create it via pgAdmin, or let the
#                  Settings page's "Create / verify tables" button do it)

# "mysql" or "postgres"
DB_TYPE=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=staffscore

SENDER_EMAIL=your_sender_account@gmail.com
SENDER_PASSWORD=asdfqwerzxcvtyui

# ---- Example MySQL values (uncomment / use instead) ----
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=change-me
# DB_NAME=staffscore

